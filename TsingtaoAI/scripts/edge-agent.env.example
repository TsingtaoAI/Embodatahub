# 边缘采集代理配置
# 复制为 edge-agent.env，修改后使用:
#   python edge-agent.py --config edge-agent.env

# ── 必填 ──
EDGE_SOURCE=/dev/video0          # 视频源: /dev/video0 或 rtsp://...
EDGE_MISSION=my-robot-cam        # 采集任务名

# ── MinIO 连接 ──
MINIO_ENDPOINT=192.168.1.107:9000
MINIO_ACCESS_KEY=pMEKIOCnYJhmssiKZDGU
MINIO_SECRET_KEY=ECnXGyUR5ZrPsxeD5JEWxtI1CMZFMJ8kTJMMAQ5B
MINIO_BUCKET=data

# ── 视频参数 ──
SEGMENT_SECONDS=10               # 分段时长（秒）
RESOLUTION=1280x720              # 分辨率
FPS=30                           # 帧率
CRF=23                           # 质量（越小越高，18-28）

# ── 平台集成（可选）──
# BACKEND_URL=http://192.168.1.107:3000
# API_KEY=your-api-key-here
# PROJECT=my-project
